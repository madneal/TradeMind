# LLM 配置（OpenAI 兼容端点，变量名沿用 XAI_* 但适用于任何兼容服务）
#
# ── 方案一：智谱 GLM（推荐，去 https://open.bigmodel.cn → API Keys 申请）──
XAI_API_KEY=
XAI_MODEL=glm-4.5-air
XAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 更强模型可换：XAI_MODEL=glm-4.7
#
# ── 方案二：xAI Grok（https://console.x.ai）──
# XAI_API_KEY=xai-xxxxx
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1
#
# ── 方案三：OpenAI ──
# XAI_API_KEY=sk-xxxxx
# XAI_MODEL=gpt-4o
# XAI_BASE_URL=https://api.openai.com/v1
